# ColorMagic API Environment Configuration Example
APP_NAME=ColorMagic-API
APP_ENV=production
APP_DEBUG=false
APP_URL=https://colormagic-api.techkreative.com
API_VERSION=v2

# SQLite Database Configuration
# Path is relative to project root or parent directory
DB_DRIVER=sqlite
DB_PATH=data/colormagic.sqlite

# Cache & Performance Settings
CACHE_ENABLED=true
CACHE_TTL=86400
GZIP_COMPRESSION=true

# Security & Future Community Palettes Dashboard
API_SECRET_KEY=change_me_to_a_random_32_character_secret_key
RATE_LIMIT_ENABLED=false
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_WINDOW=60
