# ──────────────────────────────────────────────
# Color Magic — Environment Variables
# Copy this file to .env.local and fill in values
# ──────────────────────────────────────────────

# Public site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://colormagic.techkreative.com

# Google OAuth 2.0 (NextAuth)
GOOGLE_CLIENT_ID=927716698123-02bjkak6l8s0gpr7l36igq779l35udsg.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# NextAuth Configuration
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=https://colormagic.techkreative.com
AUTH_TRUST_HOST=true

# Google Analytics Measurement ID
NEXT_PUBLIC_GA_ID=G-537L4MR968

# Environment
NODE_ENV=production

# Cloudflare (Optional)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_ZONE_ID=your_cloudflare_zone_id