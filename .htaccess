Options -MultiViews
RewriteEngine On

# ── Localhost: subfolder base (/ColorMagic/) ─────────────────────────────────
RewriteCond %{HTTP_HOST} ^(localhost|127\.0\.0\.1)(:\d+)?$ [NC]
RewriteRule ^color/([A-Fa-f0-9]{6})/?$ /ColorMagic/color.php?hex=$1 [NC,L,QSA]

RewriteCond %{HTTP_HOST} ^(localhost|127\.0\.0\.1)(:\d+)?$ [NC]
RewriteRule ^colors/([A-Fa-f0-9]{6})\.webp$ /ColorMagic/colorImage.php?hex=$1 [L]

RewriteCond %{HTTP_HOST} ^(localhost|127\.0\.0\.1)(:\d+)?$ [NC]
RewriteRule ^$ /ColorMagic/index.html [L]

# ── Live server: root base (/) ────────────────────────────────────────────────
RewriteBase /

RewriteRule ^color/([A-Fa-f0-9]{6})/?$ color.php?hex=$1 [NC,L,QSA]

RewriteRule ^$ index.html [L]

RewriteRule ^colors/([A-Fa-f0-9]{6})\.webp$ colorImage.php?hex=$1 [L]