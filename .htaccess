Options -MultiViews
RewriteEngine On

# Redirect index.php / index.html -> / (local)
RewriteCond %{THE_REQUEST} \s/+(.*)index\.(php|html)[\s?] [NC]
RewriteCond %{HTTP_HOST} ^(localhost|127\.0\.0\.1)(:\d+)?$ [NC]
RewriteRule ^(.*)index\.(php|html)$ /ColorMagic/$1 [R=301,L,NC]

# Redirect index.php / index.html -> / (production)
RewriteCond %{THE_REQUEST} \s/+(.*)index\.(php|html)[\s?] [NC]
RewriteCond %{HTTP_HOST} !(localhost|127\.0\.0\.1)(:\d+)?$ [NC]
RewriteRule ^(.*)index\.(php|html)$ /$1 [R=301,L,NC]

# Redirect .php and .html extensions -> extensionless (local)
RewriteCond %{THE_REQUEST} \s/+(.+?)\.(php|html)[\s?] [NC]
RewriteCond %{HTTP_HOST} ^(localhost|127\.0\.0\.1)(:\d+)?$ [NC]
RewriteRule ^(.+)\.(php|html)$ /ColorMagic/$1 [R=301,L,NC]

# Redirect .php and .html extensions -> extensionless (production)
RewriteCond %{THE_REQUEST} \s/+(.+?)\.(php|html)[\s?] [NC]
RewriteCond %{HTTP_HOST} !(localhost|127\.0\.0\.1)(:\d+)?$ [NC]
RewriteRule ^(.+)\.(php|html)$ /$1 [R=301,L,NC]

# Homepage
RewriteRule ^$ index.php [L]

# Custom routes
# Hex route — exactly 6 hex chars (must come before slug rule)
RewriteRule ^color/([A-Fa-f0-9]{6})/?$ color.php?hex=$1 [NC,L,QSA]
# Slug route — named colors e.g. /color/midnight-blue/ (must start with a letter)
RewriteRule ^color/([a-zA-Z][a-zA-Z0-9-]*)/?$ color.php?slug=$1 [NC,L,QSA]
RewriteRule ^palette/([a-z0-9-]+)/?$ palette.php?slug=$1 [NC,L,QSA]
RewriteRule ^colors/([A-Fa-f0-9]{6})\.webp$ colorImage.php?hex=$1 [L]

# Generic PHP-less pages
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^([A-Za-z0-9-]+)/?$ $1.php [L]