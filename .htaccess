Options -MultiViews -Indexes
RewriteEngine On

# ── SECURITY & SEO: Redirect /pages/... and extensions to clean HTTPS URLs ────
# /pages/X.php → /X
RewriteCond %{THE_REQUEST} \s/+pages/([^\s?]+)\.(php|html) [NC]
RewriteRule ^pages/(.+)\.(php|html)$ https://%{HTTP_HOST}/$1 [R=301,L,NC]

# /pages/X → /X (extensionless direct access)
RewriteCond %{THE_REQUEST} \s/+pages/([^\s?]+)[\s?] [NC]
RewriteRule ^pages/(.+)$ https://%{HTTP_HOST}/$1 [R=301,L,NC]

# Redirect index.php / index.html → /
RewriteCond %{THE_REQUEST} \s/+(.*)index\.(php|html)[\s?] [NC]
RewriteRule ^(.*)index\.(php|html)$ https://%{HTTP_HOST}/$1 [R=301,L,NC]

# Redirect .php and .html extensions → extensionless (exclude verification files)
RewriteCond %{REQUEST_URI} !^/pinterest-.*\.html$ [NC]
RewriteCond %{REQUEST_URI} !^/yandex_.*\.html$ [NC]
RewriteCond %{REQUEST_URI} !^/google.*\.html$ [NC]
RewriteCond %{THE_REQUEST} \s/+(.+?)\.(php|html)[\s?] [NC]
RewriteRule ^(.+)\.(php|html)$ https://%{HTTP_HOST}/$1 [R=301,L,NC]

# Homepage
RewriteRule ^$ pages/index.php [L]

# Custom routes
# Hex route — exactly 6 hex chars (must come before slug rule)
RewriteRule ^color/([A-Fa-f0-9]{6})/?$ pages/colors/color.php?hex=$1 [NC,L,QSA]
# Slug route — named colors e.g. /color/midnight-blue/ (must start with a letter)
RewriteRule ^color/([a-zA-Z][a-zA-Z0-9-]*)/?$ pages/colors/color.php?slug=$1 [NC,L,QSA]
RewriteRule ^palette/([^/]+)/?$ pages/palettes/palette.php?slug=$1 [NC,L,QSA]
RewriteRule ^gradient/([a-zA-Z0-9_-]+)/?$ pages/gradients/gradient.php?id=$1 [NC,L,QSA]
RewriteRule ^colors/([A-Fa-f0-9]{6})\.webp$ pages/colors/colorImage.php?hex=$1 [L]

# Auth routes
RewriteRule ^auth/google-login/?$ auth/google-login.php [L]
RewriteRule ^auth/google-callback/?$ auth/google-callback.php [L]
RewriteRule ^auth/logout/?$ auth/logout.php [L]
RewriteRule ^auth/delete-account/?$ auth/delete-account.php [L]
RewriteRule ^auth/favorites/?$ auth/favorites.php [L]
RewriteRule ^auth/admin-auth/?$ auth/admin-auth.php [L]

# ── SECURITY: Block direct HTTP access to internal data and scripts ─────────
RewriteRule ^data(/.*)?$ - [F,L,NC]
RewriteRule ^(services|scripts|components)(/.*)?$ - [F,L,NC]
RewriteRule (^|/)\.(env|git|vscode) - [F,L,NC]

# ── ANTI-BOT PROTECTION: Block abusive scraper bots while allowing Search Engines ──
RewriteCond %{HTTP_USER_AGENT} (CriteoBot|aiohttp|python-requests|Scrapy|HttpClient|node-fetch|libwww|Wget|PostmanRuntime|Go-http-client) [NC]
RewriteCond %{HTTP_USER_AGENT} !(Googlebot|bingbot|Baiduspider|DuckDuckBot|YandexBot|Applebot|crawlers) [NC]
RewriteRule ^ - [F,L]

# Block aggressive scraping subnets identified in analytics
<RequireAll>
    Require all granted
    Require not ip 216.73.216.0/24
</RequireAll>

# Secure API dataset routing via protected gateway
RewriteRule ^api/([a-zA-Z0-9_-]+\.json)$ api/data.php?file=$1 [L,QSA]

# Dynamic Sitemap Routing
RewriteRule ^sitemap\.xml$ sitemap.php [L]
RewriteRule ^sitemap-images\.xml$ sitemap.php?type=images [L]
RewriteRule ^sitemaps/([a-zA-Z0-9_-]+)\.xml$ sitemap.php?type=$1 [L]
RewriteRule ^posters/([a-zA-Z0-9_-]+)/(.+)\.jpg$ pages/media/poster.php?category=$1&id=$2 [L,QSA]

# Static pages (explicit routes — no file-existence check needed)
# Admin routes
RewriteRule ^admin/?$ admin/index.php [L]
RewriteRule ^admin/colors/?$ admin/colors.php [L]
RewriteRule ^admin/palettes/?$ admin/palettes.php [L]
RewriteRule ^admin/gradients/?$ admin/gradients.php [L]
RewriteRule ^admin/([a-zA-Z0-9_-]+)/?$ admin/$1.php [L]
RewriteRule ^palettes/?$ pages/palettes/palettes.php [L]
RewriteRule ^gradients/?$ pages/gradients/gradients.php [L]
RewriteRule ^generate-palette/?$ pages/tools/generate-palette.php [L]
RewriteRule ^palette-from-image/?$ pages/tools/palette-from-image.php [L]
RewriteRule ^find-color/?$ pages/tools/find-color.php [L]
RewriteRule ^profile/?$ pages/account/profile.php [L]
RewriteRule ^favorites/?$ pages/account/favorites.php [L]
RewriteRule ^saved/?$ pages/account/favorites.php [L]
RewriteRule ^login/?$ pages/account/login.php [L]
RewriteRule ^open-source/?$ pages/info/open-source.php [L]
RewriteRule ^hex-to-color-name/?$ pages/tools/hex-to-color-name.php [L]
RewriteRule ^hex-to-rgb/?$ pages/tools/hex-to-rgb.php [L]
RewriteRule ^what-color-is/?$ pages/tools/what-color-is.php [L]
RewriteRule ^dark-color-finder/?$ pages/tools/dark-color-finder.php [L]
RewriteRule ^brand-color-lookup/?$ pages/tools/brand-color-lookup.php [L]
RewriteRule ^about/?$ pages/info/about.php [L]
RewriteRule ^contact/?$ pages/info/contact.php [L]
RewriteRule ^privacy-policy/?$ pages/info/privacy-policy.php [L]
RewriteRule ^terms-and-conditions/?$ pages/info/terms-and-conditions.php [L]
RewriteRule ^terms/?$ pages/info/terms-and-conditions.php [L]
RewriteRule ^cookie-policy/?$ pages/info/cookie-policy.php [L]
RewriteRule ^verify-human/?$ pages/account/verify-human.php [L]
RewriteRule ^complementary-colors/?$ pages/harmonies/complementary-colors.php [L]
RewriteRule ^analogous-colors/?$ pages/harmonies/analogous-colors.php [L]
RewriteRule ^triadic-colors/?$ pages/harmonies/triadic-colors.php [L]
RewriteRule ^monochromatic-colors/?$ pages/harmonies/monochromatic-colors.php [L]
RewriteRule ^split-complementary-colors/?$ pages/harmonies/split-complementary-colors.php [L]
RewriteRule ^tetradic-colors/?$ pages/harmonies/tetradic-colors.php [L]
RewriteRule ^harmonies/([^/]+)/?$ pages/harmonies/$1.php [L]

# ── PERFORMANCE: Gzip Compression ──────────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/x-javascript application/json application/xml image/svg+xml
</IfModule>

# ── PERFORMANCE: Browser Caching & Cache-Control ───────────────────────────
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType application/json "access plus 1 day"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(ico|pdf|jpg|jpeg|png|webp|gif|js|css|svg|woff|woff2|ttf|eot)$">
        Header set Cache-Control "max-age=31536000, public, immutable"
    </FilesMatch>
    <FilesMatch "\.(html|htm|php)$">
        Header set Cache-Control "public, max-age=3600, stale-while-revalidate=86400"
        Header set Cloudflare-CDN-Cache-Control "public, max-age=86400, stale-while-revalidate=604800"
    </FilesMatch>

    <If "%{REQUEST_URI} =~ m#^/(v2|api|data)/# && %{REQUEST_METHOD} == 'GET'">
        Header set Cache-Control "public, max-age=86400, stale-while-revalidate=604800"
        Header set Cloudflare-CDN-Cache-Control "public, max-age=86400, stale-while-revalidate=604800"
        Header set CDN-Cache-Control "public, max-age=86400"
    </If>

    # Private pages & Auth: prevent Google indexing and CDN caching
    <If "%{REQUEST_URI} =~ m#^/(auth|admin|profile|favorites|saved|login)#">
        Header always set X-Robots-Tag "noindex, nofollow"
        Header set Cache-Control "private, no-cache, no-store, must-revalidate"
        Header set Cloudflare-CDN-Cache-Control "private, no-cache, no-store, must-revalidate"
    </If>

    # Security Headers for Best Practices
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>