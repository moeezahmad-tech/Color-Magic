# See https://help.github.com/articles/ignoring-files/ for more information.

# ── Dependencies ────────────────────────────────────────────────────────────
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions


# ── Next.js build output ────────────────────────────────────────────────────
/.next/
/out/
/build

# ── Testing ─────────────────────────────────────────────────────────────────
/coverage

# ── Environment files — NEVER commit real credentials ───────────────────────
# Ignore all .env* files by default
.env*
# Explicitly keep the safe example file tracked
!.env.example
# Also ignore the legacy env file that contains real credentials
.env.colormagic

# ── Vercel ───────────────────────────────────────────────────────────────────
.vercel

# ── TypeScript ───────────────────────────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ── OS / Editor ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.pem

# ── Logs ─────────────────────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
