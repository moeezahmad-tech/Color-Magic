# ColorMagic High-Performance API .htaccess
# Serves colormagic-api.techkreative.com

DirectoryIndex index.php
Options -Indexes +FollowSymLinks

<IfModule mod_headers.c>
    # Enable CORS for all origins
    Header set Access-Control-Allow-Origin "*"
    Header set Access-Control-Allow-Methods "GET, POST, OPTIONS"
    Header set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With"
    Header set Cache-Control "max-age=86400, public, stale-while-revalidate=604800"
</IfModule>

# Ensure proper MIME type for static JSON files
AddType application/json .json

# Enable Gzip Compression for JSON payloads
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Handle HTTP OPTIONS preflight requests
    RewriteCond %{REQUEST_METHOD} OPTIONS
    RewriteRule ^(.*)$ - [R=200,L]

    # --- V2 RESTful API Routing (Must be routed before directory/file fallthrough) ---
    RewriteRule ^v2(/.*)?$ v2/index.php [L,QSA]
    RewriteRule ^health/?$ v2/index.php [L,QSA]
    RewriteRule ^colors?/([0-9A-Fa-f]{3,8})/?$ v2/index.php [L,QSA]

    # --- V1 Legacy Endpoint URL Rewriting ---
    RewriteRule ^v1/gradients/?$ gradients.php [L,QSA]
    RewriteRule ^v1/palettes/?$ palettes.php [L,QSA]
    RewriteRule ^v1/colors/?$ colors.php [L,QSA]
    RewriteRule ^v1/health/?$ index.php [L,QSA]

    RewriteRule ^gradients/?$ gradients.php [L,QSA]
    RewriteRule ^palettes/?$ palettes.php [L,QSA]
    RewriteRule ^colors/?$ colors.php [L,QSA]

    # Allow direct static file access if physical file exists
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]
</IfModule>
